From 79c828ee1b090847ad5971d853a03a0343a2c89b Mon Sep 17 00:00:00 2001
From: Uzair Aftab <git@uzaaft.me>
Date: Mon, 12 Oct 2026 11:41:25 +0200
Subject: [PATCH] fix textview wrapping of multi-byte text

When wrapping was on, TextView split each line every width bytes. A
multi-byte character, like a box-drawing line, got cut in half at the
wrap point and drawn as U+FFFD replacement characters. Wide characters
were miscounted too, so CJK text wrapped well before the edge. In k9s
this shows up in every wrapped view that has non-ASCII text, e.g. the
border lines of the error ("Ruroh?") screen.

The wrap now walks the line one grapheme cluster at a time with
iterateString and stops at the last cluster that still fits in width
cells. A single cluster wider than the view is still extracted on its
own, as before.
---
 textview.go | 18 +++++++++++-------
 1 file changed, 11 insertions(+), 7 deletions(-)

diff --git a/textview.go b/textview.go
index 3cc840d..96a6e01 100644
--- a/textview.go
+++ b/textview.go
@@ -772,13 +772,17 @@ func (t *TextView) reindexBuffer(width int) {
 		if t.wrap && len(strippedStr) > 0 {
 			var extract string
 			for len(strippedStr) > 0 {
-				// !!BOZO!! This is a dog. Would this work instead??
-				// extract := runewidth.Truncate(strippedStr, width, "")
-				if len(strippedStr) > width {
-					extract = strippedStr[:width]
-				} else {
-					extract = strippedStr
-				}
+				// Take as many whole grapheme clusters as fit in width
+				// screen cells. Slicing by bytes would split multi-byte
+				// characters and miscount wide ones.
+				extract = strippedStr
+				iterateString(strippedStr, func(_ rune, _ []rune, textPos, _, screenPos, screenWidth int) bool {
+					if screenPos+screenWidth > width {
+						extract = strippedStr[:textPos]
+						return true
+					}
+					return false
+				})
 
 				if len(extract) == 0 {
 					// We'll extract at least one grapheme cluster.
