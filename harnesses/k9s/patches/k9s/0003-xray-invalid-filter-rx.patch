+func TestRxMatchInvalidRegexp(t *testing.T) {
+	assert.True(t, rxMatch("fred", "default::fred"))
+	assert.NotPanics(t, func() {
+		assert.False(t, rxMatch("?1x:pvc", "default::fred"))
+	})
