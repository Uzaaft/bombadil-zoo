 internal/model/tree.go             |  5 ++++-
 internal/view/xray.go              | 10 ++++++++--
 internal/view/xray_int_test.go     | 29 +++++++++++++++++++++++++++++
 4 files changed, 48 insertions(+), 3 deletions(-)

