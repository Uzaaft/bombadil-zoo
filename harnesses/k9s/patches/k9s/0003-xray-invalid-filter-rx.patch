diff --git a/internal/view/xray_int_test.go b/internal/view/xray_int_test.go
index df27615e..428cd41b 100644
--- a/internal/view/xray_int_test.go
+++ b/internal/view/xray_int_test.go
@@ -20,3 +20,32 @@ func TestXrayGotoCmdBeforeTreeLoaded(t *testing.T) {
